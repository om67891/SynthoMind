    <script>
        // Toggle mobile menu
        document.querySelector('.menu-toggle').addEventListener('click', function() {
            document.querySelector('.sidebar').classList.toggle('active');
        });
        
        // Initialize date picker
        flatpickr("#dateRange", {
            mode: "range",
            dateFormat: "Y-m-d",
            defaultDate: ["2023-01-01", "2023-12-31"]
        });
        
        // Chart.js implementation
        const trendCtx = document.getElementById('trendChart').getContext('2d');
        const moodCtx = document.getElementById('moodDistributionChart').getContext('2d');
        
        // Trend Chart
        const trendChart = new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [
                    {
                        label: 'Mood',
                        data: [6.2, 6.5, 6.8, 7.1, 7.3, 7.0, 7.2, 7.5, 7.8, 7.6, 7.4, 7.2],
                        borderColor: '#5d5fef',
                        backgroundColor: 'rgba(93, 95, 239, 0.1)',
                        tension: 0.3,
                        fill: true
                    },
                    {
                        label: 'Stress',
                        data: [7.5, 7.2, 6.8, 6.5, 6.2, 6.0, 5.8, 5.5, 5.3, 5.5, 5.7, 5.8],
                        borderColor: '#ff6b6b',
                        backgroundColor: 'rgba(255, 107, 107, 0.1)',
                        tension: 0.3,
                        fill: true
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'top',
                    }
                },
                scales: {
                    y: {
                        beginAtZero: false,
                        min: 4,
                        max: 10,
                        title: {
                            display: true,
                            text: 'Score (1-10)'
                        }
                    }
                }
            }
        });
        
        // Mood Distribution Chart
        const moodChart = new Chart(moodCtx, {
            type: 'doughnut',
            data: {
                labels: ['Positive', 'Neutral', 'Negative'],
                datasets: [{
                    data: [65, 25, 10],
                    backgroundColor: [
                        '#1dd1a1',
                        '#feca57',
                        '#ff6b6b'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
        
        // Period switching for charts
        document.querySelectorAll('.chart-action-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.chart-action-btn').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                
                // In a real app, this would fetch new data based on the selected period
                console.log('Switching to period:', this.dataset.period);
            });
        });
        
        // Export functionality
        document.getElementById('exportPdf').addEventListener('click', function() {
            alert('PDF export functionality would be implemented here. In a real app, this would generate a PDF report.');
        });
        
        document.getElementById('exportData').addEventListener('click', function() {
            alert('Data export functionality would be implemented here. This would download a CSV or JSON file with your mental health data.');
        });
        
        document.getElementById('generateReport').addEventListener('click', function() {
            alert('Report generation would refresh the data based on the selected date range.');
        });
        
        document.getElementById('printReport').addEventListener('click', function() {
            window.print();
        });
    </script>
