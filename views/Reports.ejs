<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MindCare AI | Mental Health Reports</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        :root {
            --primary: #5d5fef;
            --primary-light: #e0e1ff;
            --secondary: #4ecdc4;
            --accent: #ff6b6b;
            --light: #f8f9fa;
            --dark: #2d3436;
            --gray: #a5b1c2;
            --success: #1dd1a1;
            --warning: #feca57;
            --danger: #ff6b6b;
            --shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --radius: 12px;
        }

        body {
            background-color: #f0f2f5;
            color: var(--dark);
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar Styles */
        .sidebar {
            width: 260px;
            background: linear-gradient(135deg, var(--primary), #6c5ce7);
            color: white;
            padding: 20px;
            display: flex;
            flex-direction: column;
            box-shadow: var(--shadow);
            z-index: 10;
        }

        .logo {
            display: flex;
            align-items: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
        }

        .logo i {
            font-size: 28px;
            margin-right: 10px;
        }

        .logo h1 {
            font-size: 22px;
            font-weight: 600;
        }

        .nav-links {
            list-style: none;
            flex: 1;
        }

        .nav-links li {
            margin-bottom: 10px;
        }

        .nav-links a {
            color: white;
            text-decoration: none;
            display: flex;
            align-items: center;
            padding: 12px 15px;
            border-radius: var(--radius);
            transition: all 0.3s;
        }

        .nav-links a:hover, .nav-links a.active {
            background-color: rgba(255, 255, 255, 0.1);
        }

        .nav-links i {
            margin-right: 10px;
            font-size: 18px;
        }

        .user-profile {
            display: flex;
            align-items: center;
            padding: 15px 0;
            border-top: 1px solid rgba(255, 255, 255, 0.2);
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 10px;
            font-weight: bold;
        }

        .user-info {
            flex: 1;
        }

        .user-info h3 {
            font-size: 14px;
            margin-bottom: 5px;
        }

        .user-info p {
            font-size: 12px;
            opacity: 0.8;
        }

        .logout-btn {
            background: none;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 18px;
        }

        /* Main Content Styles */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .header {
            background-color: white;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: var(--shadow);
        }

        .header h2 {
            font-weight: 600;
            color: var(--dark);
        }

        .header-actions {
            display: flex;
            gap: 15px;
        }

        .header-btn {
            background-color: var(--primary-light);
            border: none;
            padding: 8px 15px;
            border-radius: 20px;
            color: var(--primary);
            font-weight: 500;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 5px;
            transition: all 0.3s;
        }

        .header-btn:hover {
            background-color: var(--primary);
            color: white;
        }

        /* Report Container */
        .report-container {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
        }

        .report-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .report-title h1 {
            font-size: 28px;
            color: var(--dark);
            margin-bottom: 5px;
        }

        .report-title p {
            color: var(--gray);
        }

        .report-controls {
            display: flex;
            gap: 15px;
        }

        .control-btn {
            background-color: white;
            border: 1px solid #e0e0e0;
            padding: 10px 20px;
            border-radius: var(--radius);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s;
        }

        .control-btn:hover {
            background-color: var(--primary-light);
            border-color: var(--primary);
        }

        .date-filter {
            display: flex;
            align-items: center;
            gap: 10px;
            background-color: white;
            padding: 10px 15px;
            border-radius: var(--radius);
            border: 1px solid #e0e0e0;
        }

        .date-filter input {
            border: none;
            outline: none;
            background: none;
            font-size: 14px;
            width: 150px;
        }

        /* Stats Cards */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .stat-card {
            background-color: white;
            padding: 20px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .stat-icon {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: white;
        }

        .icon-mood { background-color: #fd79a8; }
        .icon-stress { background-color: #fdcb6e; }
        .icon-sleep { background-color: #74b9ff; }
        .icon-productivity { background-color: #55efc4; }

        .stat-info h3 {
            font-size: 14px;
            color: var(--gray);
            margin-bottom: 5px;
        }

        .stat-info .value {
            font-size: 24px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .stat-info .trend {
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .trend.up { color: var(--success); }
        .trend.down { color: var(--danger); }

        /* Charts Section */
        .charts-section {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .chart-container {
            background-color: white;
            padding: 20px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .chart-header h3 {
            font-size: 18px;
            font-weight: 600;
        }

        .chart-actions {
            display: flex;
            gap: 10px;
        }

        .chart-action-btn {
            background: none;
            border: none;
            color: var(--gray);
            cursor: pointer;
            font-size: 14px;
        }

        .chart-action-btn:hover {
            color: var(--primary);
        }

        .chart-wrapper {
            height: 300px;
            position: relative;
        }

        /* Insights Section */
        .insights-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .insight-card {
            background-color: white;
            padding: 20px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .insight-card h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .insight-card h3 i {
            color: var(--primary);
        }

        .insight-list {
            list-style: none;
        }

        .insight-item {
            padding: 10px 0;
            border-bottom: 1px solid #f0f0f0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .insight-item:last-child {
            border-bottom: none;
        }

        .insight-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            color: white;
        }

        .insight-positive { background-color: var(--success); }
        .insight-warning { background-color: var(--warning); }
        .insight-info { background-color: var(--primary); }

        .insight-text {
            flex: 1;
        }

        .insight-text p {
            font-size: 14px;
            margin-bottom: 5px;
        }

        .insight-text span {
            font-size: 12px;
            color: var(--gray);
        }

        /* Journal Entries */
        .journal-section {
            background-color: white;
            padding: 20px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            margin-bottom: 30px;
        }

        .journal-section h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .journal-entries {
            max-height: 300px;
            overflow-y: auto;
        }

        .journal-entry {
            padding: 15px;
            border-radius: var(--radius);
            background-color: #f8f9fa;
            margin-bottom: 10px;
        }

        .journal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
        }

        .journal-date {
            font-weight: 600;
            font-size: 14px;
        }

        .journal-mood {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            color: var(--gray);
        }

        .journal-content {
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 10px;
        }

        .journal-sentiment {
            display: flex;
            align-items: center;
            gap: 5px;
            font-size: 12px;
            color: var(--gray);
        }

        /* Recommendations */
        .recommendations-section {
            background-color: white;
            padding: 20px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .recommendations-section h3 {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .recommendation-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 15px;
        }

        .recommendation-card {
            padding: 15px;
            border-radius: var(--radius);
            background-color: #f8f9fa;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .recommendation-icon {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--primary-light);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            flex-shrink: 0;
        }

        .recommendation-content h4 {
            font-size: 14px;
            margin-bottom: 5px;
        }

        .recommendation-content p {
            font-size: 13px;
            color: var(--gray);
        }

        /* Responsive Design */
        @media (max-width: 1200px) {
            .charts-section {
                grid-template-columns: 1fr;
            }
            
            .insights-section {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 1024px) {
            .sidebar {
                width: 80px;
                padding: 20px 10px;
            }
            
            .logo h1, .nav-links span, .user-info {
                display: none;
            }
            
            .logo {
                justify-content: center;
            }
            
            .nav-links a {
                justify-content: center;
                padding: 15px 0;
            }
            
            .nav-links i {
                margin-right: 0;
                font-size: 20px;
            }
            
            .user-profile {
                justify-content: center;
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                position: fixed;
                left: -100%;
                transition: left 0.3s;
                height: 100vh;
                z-index: 100;
            }
            
            .sidebar.active {
                left: 0;
            }
            
            .header {
                padding: 15px;
            }
            
            .report-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }
            
            .report-controls {
                width: 100%;
                justify-content: space-between;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            font-size: 20px;
            color: var(--dark);
            cursor: pointer;
        }

        @media (max-width: 768px) {
            .menu-toggle {
                display: block;
            }
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="logo">
            <i class="fas fa-brain"></i>
            <h1>MindCare AI</h1>
        </div>
        
        <ul class="nav-links">
            <li><a href="/home"><i class="fas fa-comment-dots"></i> <span>Chat</span></a></li>
            <!-- <li><a href="/insights"><i class="fas fa-chart-line"></i> <span>Insights</span></a></li>
            <li><a href="/journal"><i class="fas fa-book"></i> <span>Journal</span></a></li> -->
            <!-- <li><a href="/report" class="active"><i class="fas fa-chart-bar"></i> <span>Reports</span></a></li> -->
            <li><a href="/profile"><i class="fas fa-cog"></i> <span>Profile</span></a></li>
            <!-- <li><a href="/privacy"><i class="fas fa-shield-alt"></i> <span>Privacy</span></a></li> -->
        </ul>
        
        <div class="user-profile">
            <div class="user-avatar">JD</div>
            <div class="user-info">
                <h3>John Doe</h3>
                <p>Premium Member</p>
            </div>
            <button class="logout-btn"><i class="fas fa-sign-out-alt"></i></button>
        </div>
    </div>
    
    <!-- Main Content -->
    <div class="main-content">
        <div class="header">
            <button class="menu-toggle"><i class="fas fa-bars"></i></button>
            <h2>Mental Health Reports & Analytics</h2>
            <div class="header-actions">
                <button class="header-btn" id="exportPdf"><i class="fas fa-file-pdf"></i> Export PDF</button>
                <button class="header-btn" id="exportData"><i class="fas fa-download"></i> Export Data</button>
            </div>
        </div>
        
        <div class="report-container">
            <div class="report-header">
                <div class="report-title">
                    <h1>Mental Wellness Report</h1>
                    <p>Generated on <%= new Date().toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                </div>
                <div class="report-controls">
                    <div class="date-filter">
                        <i class="fas fa-calendar-alt"></i>
                        <input type="text" id="dateRange" placeholder="Select Date Range">
                    </div>
                    <button class="control-btn" id="generateReport"><i class="fas fa-sync-alt"></i> Generate Report</button>
                    <button class="control-btn" id="printReport"><i class="fas fa-print"></i> Print</button>
                </div>
            </div>
            
            <!-- Stats Cards -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon icon-mood">
                        <i class="fas fa-smile"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Average Mood</h3>
                        <div class="value">7.2/10</div>
                        <div class="trend up">
                            <i class="fas fa-arrow-up"></i> 12% improvement from last month
                        </div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon icon-stress">
                        <i class="fas fa-tachometer-alt"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Stress Level</h3>
                        <div class="value">5.8/10</div>
                        <div class="trend down">
                            <i class="fas fa-arrow-down"></i> 8% decrease from last month
                        </div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon icon-sleep">
                        <i class="fas fa-bed"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Sleep Quality</h3>
                        <div class="value">6.5/10</div>
                        <div class="trend up">
                            <i class="fas fa-arrow-up"></i> 5% improvement from last month
                        </div>
                    </div>
                </div>
                
                <div class="stat-card">
                    <div class="stat-icon icon-productivity">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <div class="stat-info">
                        <h3>Productivity</h3>
                        <div class="value">7.8/10</div>
                        <div class="trend up">
                            <i class="fas fa-arrow-up"></i> 15% improvement from last month
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Charts Section -->
            <div class="charts-section">
                <div class="chart-container">
                    <div class="chart-header">
                        <h3>Mood & Stress Trends</h3>
                        <div class="chart-actions">
                            <button class="chart-action-btn" data-period="week">1W</button>
                            <button class="chart-action-btn active" data-period="month">1M</button>
                            <button class="chart-action-btn" data-period="quarter">3M</button>
                            <button class="chart-action-btn" data-period="year">1Y</button>
                        </div>
                    </div>
                    <div class="chart-wrapper">
                        <canvas id="trendChart"></canvas>
                    </div>
                </div>
                
                <div class="chart-container">
                    <div class="chart-header">
                        <h3>Mood Distribution</h3>
                        <div class="chart-actions">
                            <button class="chart-action-btn"><i class="fas fa-ellipsis-h"></i></button>
                        </div>
                    </div>
                    <div class="chart-wrapper">
                        <canvas id="moodDistributionChart"></canvas>
                    </div>
                </div>
            </div>
            
            <!-- Insights Section -->
            <div class="insights-section">
                <div class="insight-card">
                    <h3><i class="fas fa-lightbulb"></i> Key Insights</h3>
                    <ul class="insight-list">
                        <li class="insight-item">
                            <div class="insight-icon insight-positive">
                                <i class="fas fa-thumbs-up"></i>
                            </div>
                            <div class="insight-text">
                                <p>Your mood consistently improves after physical activity</p>
                                <span>Based on 28 journal entries</span>
                            </div>
                        </li>
                        <li class="insight-item">
                            <div class="insight-icon insight-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                            </div>
                            <div class="insight-text">
                                <p>Stress levels peak on Tuesday afternoons</p>
                                <span>Consider scheduling lighter tasks</span>
                            </div>
                        </li>
                        <li class="insight-item">
                            <div class="insight-icon insight-info">
                                <i class="fas fa-info-circle"></i>
                            </div>
                            <div class="insight-text">
                                <p>Sleep quality directly correlates with next-day productivity</p>
                                <span>Correlation coefficient: 0.78</span>
                            </div>
                        </li>
                    </ul>
                </div>
                
                <div class="insight-card">
                    <h3><i class="fas fa-chart-line"></i> Progress Tracking</h3>
                    <ul class="insight-list">
                        <li class="insight-item">
                            <div class="insight-icon insight-positive">
                                <i class="fas fa-arrow-up"></i>
                            </div>
                            <div class="insight-text">
                                <p>Anxiety symptoms decreased by 35% over the past 3 months</p>
                                <span>Great progress!</span>
                            </div>
                        </li>
                        <li class="insight-item">
                            <div class="insight-icon insight-positive">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div class="insight-text">
                                <p>Consistently practicing mindfulness 4+ times per week</p>
                                <span>Keep up the good habit</span>
                            </div>
                        </li>
                        <li class="insight-item">
                            <div class="insight-icon insight-warning">
                                <i class="fas fa-bell"></i>
                            </div>
                            <div class="insight-text">
                                <p>Social interaction decreased by 20% this month</p>
                                <span>Consider reaching out to friends</span>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
            
            <!-- Journal Entries -->
            <div class="journal-section">
                <h3>Recent Journal Entries</h3>
                <div class="journal-entries">
                    <div class="journal-entry">
                        <div class="journal-header">
                            <div class="journal-date">Today, 10:30 AM</div>
                            <div class="journal-mood">
                                <i class="fas fa-smile"></i> Positive
                            </div>
                        </div>
                        <div class="journal-content">
                            Feeling much better after my morning walk. The sunshine really helped lift my mood. I'm feeling optimistic about the project deadline.
                        </div>
                        <div class="journal-sentiment">
                            <i class="fas fa-chart-bar"></i> Sentiment: Positive (85%)
                        </div>
                    </div>
                    
                    <div class="journal-entry">
                        <div class="journal-header">
                            <div class="journal-date">Yesterday, 8:15 PM</div>
                            <div class="journal-mood">
                                <i class="fas fa-meh"></i> Neutral
                            </div>
                        </div>
                        <div class="journal-content">
                            Long day at work. Feeling tired but accomplished. Need to work on setting better boundaries with after-hours emails.
                        </div>
                        <div class="journal-sentiment">
                            <i class="fas fa-chart-bar"></i> Sentiment: Neutral (62%)
                        </div>
                    </div>
                    
                    <div class="journal-entry">
                        <div class="journal-header">
                            <div class="journal-date">2 days ago, 7:45 PM</div>
                            <div class="journal-mood">
                                <i class="fas fa-frown"></i> Stressed
                            </div>
                        </div>
                        <div class="journal-content">
                            Overwhelmed with the project deadline. Having trouble focusing. Took a break to meditate which helped slightly.
                        </div>
                        <div class="journal-sentiment">
                            <i class="fas fa-chart-bar"></i> Sentiment: Negative (72%)
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Recommendations -->
            <div class="recommendations-section">
                <h3>Personalized Recommendations</h3>
                <div class="recommendation-list">
                    <div class="recommendation-card">
                        <div class="recommendation-icon">
                            <i class="fas fa-walking"></i>
                        </div>
                        <div class="recommendation-content">
                            <h4>Increase Physical Activity</h4>
                            <p>Data shows your mood improves by 30% after 20+ minutes of exercise</p>
                        </div>
                    </div>
                    
                    <div class="recommendation-card">
